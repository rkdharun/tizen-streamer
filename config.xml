<?xml version="1.0" encoding="UTF-8"?>
<widget xmlns="http://www.w3.org/ns/widgets"
        xmlns:tizen="http://tizen.org/ns/widgets"
        id="http://reeltv.local/app"
        version="1.0.0"
        viewmodes="maximized">

    <tizen:application id="ReelTVApp1.ReelTV" package="ReelTVApp1" required_version="4.0"/>
    <tizen:profile name="tv-samsung"/>

    <name>ReelTV</name>
    <description>Browse movies, TV shows and anime with the remote.</description>
    <icon src="icon.png"/>
    <content src="index.html"/>

    <feature name="http://tizen.org/feature/screen.size.normal.1080.1920"/>

    <!-- Network access for TMDB + embed providers (iframes) -->
    <access origin="*" subdomains="true"/>

    <!-- Required for external pages to load inside the player iframe on Samsung TVs
         (without it, embeds stay blank in every shield mode). Embeds pull nested frames
         from many changing domains, so this must be "*". Top-frame ad redirects are still
         blocked by the iframe sandbox (shield strict / popups ok) and the redirect guard. -->
    <tizen:allow-navigation>*</tizen:allow-navigation>

    <tizen:privilege name="http://tizen.org/privilege/internet"/>
    <tizen:privilege name="http://tizen.org/privilege/tv.inputdevice"/>
    <tizen:privilege name="http://developer.samsung.com/privilege/network.public"/>

    <tizen:content-security-policy>default-src * 'unsafe-inline' 'unsafe-eval' data: blob: https: http:; frame-src * https: http: data: blob:; media-src * https: http: data: blob:; img-src * https: http: data: blob:</tizen:content-security-policy>

    <tizen:setting screen-orientation="landscape"
                   context-menu="disable"
                   background-support="disable"
                   encryption="disable"
                   install-location="auto"
                   hwkey-event="enable"/>
</widget>
